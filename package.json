{
  "name": "financas-casal",
  "version": "1.0.0",
  "description": "Controle financeiro pessoal (Ingrid e Felipp) com calendario de compromissos e exportacao para o Calendario do iPhone (.ics).",
  "main": "dist/server/server.js",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.client.json",
    "build": "npm run clean && npm run build:server && npm run build:client",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "start": "node dist/server/server.js",
    "dev": "npm run build && node dist/server/server.js",
    "seed": "npm run build:server && node dist/server/database/seedCli.js"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "cookie-parser": "1.4.7",
    "dotenv": "^18.0.9",
    "express": "5.1.0",
    "googleapis": "^188.0.0",
    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "@types/sql.js": "1.4.9",
    "typescript": "5.9.3"
  }
}
