# Copie para .env apenas como referencia. O app le as variaveis do ambiente.
# No Render, configure-as em Environment (ou use o render.yaml).

PORT=3000
NODE_ENV=development

# Segredo para assinar a sessao (minimo 16 caracteres). Obrigatorio em producao.
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Duracao do login em horas
SESSION_TTL_HOURS=72

# Caminho do banco SQLite. Padrao local: ./data/financas.sqlite
# No Render com disco persistente: /var/data/financas.sqlite
# DB_PATH=./data/financas.sqlite

# Google Calendar OAuth (nao compartilhe o segredo nem o envie ao GitHub).
# Configure o segredo apenas no arquivo local .env ou nas variaveis seguras do Render.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_INGRID_ACCOUNT_EMAIL=ingridregina031@gmail.com
GOOGLE_FELIPP_ACCOUNT_EMAIL=felipp.nolasco@gmail.com
# Local OAuth callback; use the public HTTPS URL after deployment.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
